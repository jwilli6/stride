{
  "expo": {
    "name": "stride-pro",
    "slug": "stride-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stride-pro",
    "userInterfaceStyle": "dark",
    "owner": "jwilli6-2",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0e10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jwilli6.stridepro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "Allow Stride Pro to track your walk trail in real time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Stride Pro to track your walk trail in real time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0d0e10"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jwilli6.stridepro",
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Stride Pro to track your walk trail in real time."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04059060-70a0-44b9-a50d-c2a0af4fe511"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04059060-70a0-44b9-a50d-c2a0af4fe511"
    }
  }
}
