{
  "expo": {
    "name": "stride-pro",
    "slug": "stride-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tempapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "owner": "jwilli6",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0e10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jwilli6.stridepro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0d0e10"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jwilli6.stridepro"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bedcc097-8c46-4867-90d7-d9b10ba8be2d"
      }
    }
  }
}
